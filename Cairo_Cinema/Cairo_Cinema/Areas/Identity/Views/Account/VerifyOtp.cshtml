@model Cairo_Cinema.ViewModel.VerifyOtpVM

@{
    ViewData["Title"] = "Verify OTP";
}
<h1></h1>
<br />
<h4>Verify OTP</h4>
<hr />
<br />
<div class="cinema-filter-container">
    <div class="row">
        <div class="col-md-12"> 
            <form asp-action="VerifyOtp" method="post">
                <input hidden asp-for="UserId"/>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="OTP" class="control-label">Enter OTP Code</label>
                    <input asp-for="OTP" class="form-control" />
                    <span asp-validation-for="OTP" class="text-danger"></span>
                </div>
                <br />
                <div class="form-group">
                    <input type="submit" value="Verify OTP" class="btn btn-warning" />
                </div>
            </form>
            <br />

            <div>
                <a class="link-warning" asp-action="Login">Login</a>
            </div>

        </div>
    </div>
</div>
<br />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_NotificationPartial" />
}