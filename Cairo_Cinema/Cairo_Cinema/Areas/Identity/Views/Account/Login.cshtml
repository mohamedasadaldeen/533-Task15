@model Cairo_Cinema.ViewModel.LoginVM

@{
    ViewData["Title"] = "Login";
}

<h1></h1>
<br />
<h4>Login Page</h4>
<hr />
<br />
<div class="cinema-filter-container">
    <div class="row">
        <div class="col-md-12">
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="UserNameOrEmail" class="control-label">UserName Or Email</label>
                    <input asp-for="UserNameOrEmail" class="form-control" />
                    <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="control-label"></label>
                    <input asp-for="Password" class="form-control" type="password"/>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>


                <div class="form-group">
                    <label asp-for="RememberMe" class="control-label"></label>
                    <input asp-for="RememberMe" type="checkbox"/>
                    <span asp-validation-for="RememberMe" class="text-danger"></span>
                </div>
                <br />

                <div class="form-group">
                    <input type="submit" value="Login" class="btn btn-warning" />
                </div>
            </form>
            <br />

            <div>
                <a class="link-warning" asp-action="Register">Register</a>
            </div>

            <div>
                <a class="link-warning" asp-action="ResendEmailConfirmation">Confirmation Email</a>
            </div>

            <div>
                <a class="link-warning" asp-action="ForgetPassword">Forget Password !</a>
            </div>

        </div>
    </div>
</div>
<br />
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <partial name="_NotificationPartial" />
} 