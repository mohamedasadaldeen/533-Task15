using Cairo_Cinema.Models
@model Cinema

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="fas fa-plus-circle text-warning me-2"></i>
                Create Cinema
            </h2>
            <p class="text-secondary mb-0">
                Add a new cinema to your cinema website.
            </p>
        </div>

        <a href="/Admin/Cinema/Index" class="btn btn-outline-warning">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Cinemas
        </a>
    </div>

    <!-- Create Cinema Form -->
    <div class="row">
        <div class="col-12 col-lg-12 col-xl-12">

            <div class="card bg-dark text-light border-secondary shadow-sm">

                <div class="card-header border-secondary py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-layer-group text-warning me-2"></i>
                        Cinema Information
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">

                        <!-- Name -->
                        <div class="mb-4">
                            <label for="Name" class="form-label fw-semibold">
                                Cinema Name <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="Name"
                                   asp-for="Name"
                                   placeholder="Enter cinema name"
                                   required>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label for="Description" class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea class="form-control"
                                      id="Description"
                                      asp-for="Description"
                                      rows="4"
                                      placeholder="Write a short description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Image -->
                        <div class="mb-4">
                            <label for="Image" class="form-label fw-semibold">
                                Cinema Image <span class="text-danger">*</span>
                            </label>

                            <input type="file"
                                   class="form-control"
                                   id="Image"
                                   name="ImageFile"
                                   accept="image/*"
                                   onchange="previewImage(event)">
                            <span asp-validation-for="Image" class="text-danger small"></span>


                            <!-- Image Preview -->
                            <div class="mt-3">
                                <img id="preview"
                                     src="#"
                                     alt="Cinema Image Preview"
                                     style="display: none;
                                width: 200px;
                                height: 140px;
                                object-fit: cover;
                                border-radius: 10px;
                                border: 1px solid #dee2e6;
                                padding: 5px;">
                            </div>
                        </div>

                        <!-- Status -->

                        <div class="mb-4">
                            <label class="form-label fw-semibold d-block">
                                Status
                            </label>

                            <div class="d-flex align-items-center gap-3">
                                <div class="form-check form-switch fs-5 mb-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="Status"
                                           asp-for="Status">
                                    <span asp-validation-for="Status" class="text-danger small"></span>

                                </div>

                                <span id="statusText" class="badge bg-success">
                                    Active
                                </span>
                            </div>
                        </div>

                        <hr class="border-secondary">

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2">

                            <a href="#" class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="reset" class="btn btn-outline-warning">
                                <i class="fas fa-redo me-1"></i>
                                Reset
                            </button>

                            <button type="submit" class="btn btn-warning fw-semibold">
                                <i class="fas fa-save me-1"></i>
                                Create Cinema
                            </button>

                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>

</div>
@section Scripts {

    <partial name="_ValidationScriptsPartial" />
}

@* Status *@
<script>
    const statusSwitch = document.getElementById('Status');
    const statusText = document.getElementById('statusText');

    function updateStatus() {
        statusText.textContent = statusSwitch.checked ? 'Active' : 'Inactive';

        statusText.className = statusSwitch.checked
            ? 'badge bg-success'
            : 'badge bg-danger';
    }

    statusSwitch.addEventListener('change', updateStatus);

    updateStatus();
</script>
@* Image *@
<script>
    function previewImage(event) {
        const file = event.target.files[0];
        const preview = document.getElementById('preview');

        if (file) {
            preview.src = URL.createObjectURL(file);
            preview.style.display = 'block';
        } else {
            preview.src = '#';
            preview.style.display = 'none';
        }
    }
</script>