@using Cairo_Cinema.Models
@model IEnumerable<Cinema>

<style>
    .cinemas-page {
        color: #e9ecef;
    }

    .cinemas-card {
        background: #1b1f24;
        border: 1px solid #343a40;
        border-radius: 16px;
        overflow: hidden;
    }

    .cinemas-header {
        background: linear-gradient(135deg, #212529, #343a40);
        padding: 22px 25px;
        border-bottom: 1px solid #454b52;
    }

    .cinemas-title {
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .cinemas-subtitle {
        color: #adb5bd;
        font-size: .9rem;
        margin: 0;
    }

    .cinemas-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 35px;
        height: 35px;
        padding: 0 10px;
        border-radius: 10px;
        background: rgba(255, 193, 7, .14);
        color: #ffc107;
        font-weight: 700;
    }

    .btn-add-cinema {
        background: #ffc107;
        color: #212529;
        border: none;
        border-radius: 9px;
        padding: 10px 16px;
        font-weight: 700;
        transition: .2s ease;
        text-decoration: none;
    }

        .btn-add-cinema:hover {
            background: #ffca2c;
            color: #212529;
            transform: translateY(-2px);
        }

    .cinemas-table {
        margin-bottom: 0;
        color: #e9ecef;
        border-color: #343a40;
    }

        .cinemas-table thead th {
            background: #252a30;
            color: #ffc107;
            font-size: .85rem;
            font-weight: 700;
            padding: 16px 12px;
            white-space: nowrap;
            border-color: #343a40;
        }

        .cinemas-table tbody td {
            background: #1b1f24;
            padding: 14px 12px;
            vertical-align: middle;
            border-color: #343a40;
        }

        .cinemas-table tbody tr {
            transition: background .2s ease;
        }

            .cinemas-table tbody tr:hover td {
                background: #252a30;
            }

    .cinema-id {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
        height: 32px;
        padding: 0 8px;
        border-radius: 8px;
        background: #343a40;
        color: #ffc107;
        font-weight: 700;
    }

    .cinema-name {
        color: #f8f9fa;
        font-weight: 600;
    }

    .cinema-name-icon {
        color: #ffc107;
        margin-right: 8px;
    }

    .cinema-description {
        color: #adb5bd;
        font-size: .9rem;
        min-width: 180px;
        max-width: 300px;
        line-height: 1.6;
    }

    .cinema-image {
        width: 105px;
        height: 72px;
        object-fit: cover;
        object-position: center;
        border-radius: 10px;
        border: 1px solid #495057;
        padding: 3px;
        background: #212529;
        transition: transform .2s ease;
    }

        .cinema-image:hover {
            transform: scale(1.06);
        }

    .cinema-status {
        display: inline-block;
        min-width: 85px;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: .78rem;
        font-weight: 700;
    }

    .cinema-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 9px;
        margin: 0 3px;
        transition: .2s ease;
    }

        .cinema-action:hover {
            transform: translateY(-2px);
        }

    .cinemas-footer {
        background: #212529;
        border-top: 1px solid #343a40;
        color: #adb5bd;
        padding: 15px 22px;
        font-size: .85rem;
    }

    @@media (max-width: 576px) {
        .cinemas-header {
            padding: 18px 15px;
        }

        .cinemas-title {
            font-size: 1.1rem;
        }

        .btn-add-cinema {
            padding: 9px 11px;
            font-size: .85rem;
        }
    }
</style>

<div class="container-fluid py-4 cinemas-page">

    <div class="cinemas-card shadow-lg">

        <!-- Header -->
        <div class="cinemas-header d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center"
                     style="width: 52px; height: 52px; font-size: 1.4rem;">
                    <i class="fas fa-film"></i>
                </div>

                <div>
                    <h4 class="cinemas-title">
                        Cinemas Management
                    </h4>
                    <p class="cinemas-subtitle">
                        Manage and organize your cinema locations
                    </p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="cinemas-count" title="Total cinemas">
                    @Model.Count()
                </div>

                <a href="/Admin/Cinema/Create" class="btn-add-cinema">
                    <i class="fas fa-plus me-2"></i>
                    Add Cinema
                </a>
            </div>

        </div>

        <!-- Table -->
        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-bordered text-center align-middle cinemas-table">

                    <thead>
                        <tr>
                            <th style="width: 85px;">ID</th>
                            <th style="min-width: 180px;">Cinema Name</th>
                            <th style="min-width: 220px;">Description</th>
                            <th style="width: 145px;">Cinema Image</th>
                            <th style="width: 130px;">Status</th>
                            <th style="width: 140px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="cinema-id">
                                        #@item.Id
                                    </span>
                                </td>

                                <td class="text-start">
                                    <span class="cinema-name">
                                        <i class="fas fa-video cinema-name-icon"></i>
                                        @item.Name
                                    </span>
                                </td>

                                <td class="text-start">
                                    <div class="cinema-description">
                                        @item.Description
                                    </div>
                                </td>

                                <td>
                                    <img src="~/images/Cinema/@item.Image"
                                         alt="@item.Name"
                                         class="cinema-image"
                                         loading="lazy" />
                                </td>

                                <td>
                                    @if (item.Status == true)
                                    {
                                        <span class="badge bg-success cinema-status">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger cinema-status">
                                            <i class="fas fa-times-circle me-1"></i>
                                            InActive
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a asp-controller="Cinema"
                                       asp-action="Update"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-warning cinema-action"
                                       title="Edit Cinema"
                                       aria-label="Edit Cinema">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <a asp-controller="Cinema"
                                       asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger cinema-action"
                                       title="Delete Cinema"
                                       aria-label="Delete Cinema"
                                       onclick="confirmDelete(event, this)">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>

        <!-- Footer -->
        <div class="cinemas-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
                <i class="fas fa-film text-warning me-2"></i>
                Cairo Cinema
            </span>

            <span>
                Total Cinemas:
                <strong class="text-warning">@Model.Count()</strong>
            </span>
        </div>

    </div>
</div>
@section Scripts {
    <partial name="_NotificationPartial" />
}
@* SweetAlert(Delete) *@
<script>
    function confirmDelete(event, element) {
        event.preventDefault();

        const deleteUrl = element.href;

        const swalWithBootstrapButtons = Swal.mixin({
            customClass: {
                confirmButton: "btn btn-success",
                cancelButton: "btn btn-danger"
            },
            buttonsStyling: false
        });

        swalWithBootstrapButtons.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "No, cancel!",
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                swalWithBootstrapButtons.fire({
                    title: "Deleted!",
                    text: "Your cinema has been deleted.",
                    icon: "success",
                    showConfirmButton: false,
                    timer: 1500
                }).then(() => {
                    window.location.href = deleteUrl;
                });
            }
            else if (result.dismiss === Swal.DismissReason.cancel) {
                swalWithBootstrapButtons.fire({
                    title: "Cancelled",
                    text: "Your cinema is safe.",
                    icon: "error"
                });
            }
        });
    }
</script>