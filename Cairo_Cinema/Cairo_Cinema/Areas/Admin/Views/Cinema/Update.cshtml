@using Cairo_Cinema.Models
@model Cinema

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="fas fa-plus-circle text-warning me-2"></i>
                Update Cinema
            </h2>
            
        </div>

        <a href="/Admin/Cinema/Index" class="btn btn-outline-warning">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Cinemas
        </a>
    </div>

    <!-- Create Cinema Form -->
    <div class="row">
        <div class="col-12 col-lg-12 col-xl-12">

            <div class="card bg-dark text-light border-secondary shadow-sm">

                <div class="card-header border-secondary py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-layer-group text-warning me-2"></i>
                        Cinema Information
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Update" method="post" enctype="multipart/form-data">
                        <input asp-for="Id" hidden />
                        <!-- Name -->
                        <div class="mb-4">
                            <label for="Name" class="form-label fw-semibold">
                                Cinema Name <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="Name"
                                   asp-for="Name"
                                   placeholder="Update cinema name"
                                   required>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label for="Description" class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea class="form-control"
                                      id="Description"
                                      asp-for="Description"
                                      rows="4"
                                      placeholder="Write a short description..."></textarea>
                        </div>

                        <!-- Image -->
                        <div class="mb-4">
                            <label for="Image" class="form-label fw-semibold">
                                Cinema Image <span class="text-danger">*</span>
                            </label>

                            <input type="file"
                                   class="form-control"
                                   id="Image"
                                   name="ImageFile"
                                   accept="image/*"
                                   onchange="previewImage(event)">
                        </div>

                        <!-- Image Preview -->
                        <div class="mb-3">
                            <img id="preview"
                                 src="@Url.Content("~/Images/Cinema/" + Model.Image)"
                                 alt="Cinema Image"
                                 style="width: 200px;
                            height: 150px;
                            object-fit: contain;
                            border: 1px solid #ccc;
                            padding: 10px;
                            border-radius: 10px;" />
                        </div>

                        <!-- Status -->

                        <div class="mb-4">
                            <label class="form-label fw-semibold d-block">
                                Status
                            </label>

                            <div class="d-flex align-items-center gap-3">
                                <div class="form-check form-switch fs-5 mb-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="Status"
                                           asp-for="Status">
                                </div>

                                <span id="statusText" class="badge bg-success">
                                    Active
                                </span>
                            </div>
                        </div>

                        <hr class="border-secondary">

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2">

                            <a href="#" class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="reset" class="btn btn-outline-warning">
                                <i class="fas fa-redo me-1"></i>
                                Reset
                            </button>

                            <button type="submit" class="btn btn-warning fw-semibold">
                                <i class="fas fa-save me-1"></i>
                                Update Cinema
                            </button>

                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>

</div>

@* Status *@
<script>
    const statusSwitch = document.getElementById('Status');
    const statusText = document.getElementById('statusText');

    function updateStatus() {
        statusText.textContent = statusSwitch.checked ? 'Active' : 'Inactive';

        statusText.className = statusSwitch.checked
            ? 'badge bg-success'
            : 'badge bg-danger';
    }

    statusSwitch.addEventListener('change', updateStatus);

    updateStatus();
</script>

@* Image *@
<script>
    function previewImage(event) {
        const file = event.target.files[0];
        const preview = document.getElementById('preview');

        if (file) {
            const imageUrl = URL.createObjectURL(file);
            preview.src = imageUrl;
        }
    }
</script>
