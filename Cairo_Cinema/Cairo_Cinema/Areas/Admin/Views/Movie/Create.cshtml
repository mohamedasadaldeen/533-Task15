@using Cairo_Cinema.ViewModel
@model MovieVM
@using Microsoft.AspNetCore.Mvc.Rendering
<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="fas fa-plus-circle text-warning me-2"></i>
                Create Movie
            </h2>
            <p class="text-secondary mb-0">
                Add a new movie to your movie website.
            </p>
        </div>

        <a href="/Admin/Movie/Index" class="btn btn-outline-warning">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Movies
        </a>
    </div>

    <!-- Create Movie Form -->
    <div class="row">
        <div class="col-12 col-lg-12 col-xl-12">

            <div class="card bg-dark text-light border-secondary shadow-sm">

                <div class="card-header border-secondary py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-layer-group text-warning me-2"></i>
                        Movie Information
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">

                        <!-- Name -->
                        <div class="mb-4">
                            <label for="Movie.Name" class="form-label fw-semibold">
                                <i class="fas fa-film text-warning me-2"></i>
                                Movie Name <span class="text-danger">*</span>
                            </label>
                                
                            <input type="text"
                                   class="form-control"
                                   id="Name"
                                   asp-for="Movie.Name"
                                   placeholder="Enter movie name"
                                   required>
                            <span asp-validation-for="Movie.Name" class="text-danger small"></span>
                            
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label for="Description" class="form-label fw-semibold">
                                <i class="fas fa-align-left text-warning me-2"></i>
                                Description
                            </label>

                            <textarea class="form-control"
                                      id="Description"
                                      asp-for="Movie.Description"
                                      rows="4"
                                      placeholder="Write a short description..."></textarea>
                            <span asp-validation-for="Movie.Description" class="text-danger small"></span>
                        </div>

                        <!-- Image -->
                        <div class="mb-4">
                            <label for="MainImage" class="form-label fw-semibold">
                                <i class="fas fa-image text-warning me-2"></i>
                                Movie MainImage <span class="text-danger">*</span>
                            </label>

                            <input type="file"
                                   class="form-control"
                                   id="Image"
                                   name="ImageFile"
                                   accept="image/*"
                                   onchange="previewImage(event)">

                            <!-- Image Preview -->
                            <div class="mt-3">
                                <img id="preview"
                                     src="#"
                                     alt="Movie MainImage Preview"
                                     style="display: none;
                                width: 200px;
                                height: 140px;
                                object-fit: cover;
                                border-radius: 10px;
                                border: 1px solid #dee2e6;
                                padding: 5px;">
                            </div>
                        </div>

                        <!-- Movie SubImages -->
                        <div class="mb-4">
                            <label for="Image" class="form-label fw-semibold">
                                <i class="fas fa-image text-warning me-2"></i>
                                Movie SubImages <span class="text-danger">*</span>
                            </label>

                            <input type="file"
                                   class="form-control"
                                   id="Image"
                                   name="MovieSubImages"
                                   accept="image/*"
                                   multiple
                                   onchange="previewMultipleImages(event)">

                            <!-- Images Preview -->
                            <div id="previewContainer" class="mt-3 d-flex flex-wrap gap-3">
                            </div>
                        </div>

                        <!-- Price -->
                        <div class="mb-4">
                            <label for="Price" class="form-label fw-semibold">
                                <i class="fas fa-money-bill-wave text-warning me-2"></i>
                                Movie Price <span class="text-danger">*</span>
                            </label>

                            <input type="number"
                                   class="form-control"
                                   id="Price"
                                   asp-for="Movie.Price"
                                   required>
                            <span asp-validation-for="Movie.Price" class="text-danger small"></span>
                        </div>

                        <!-- Rate -->
                        <div class="mb-4">
                            <label for="Rate" class="form-label fw-semibold">
                                <i class="fas fa-star text-warning me-2"></i>
                                Movie Rate <span class="text-danger">*</span>
                            </label>

                            <input type="number"
                                   class="form-control"
                                   id="Rate"
                                   asp-for="Movie.Rate"
                                   required>
                            <span asp-validation-for="Movie.Rate" class="text-danger small"></span>

                        </div>

                        <!-- DateTime -->
                        <div class="mb-4">
                            <label for="DateTime" class="form-label fw-semibold">
                                <i class="fas fa-calendar-alt text-warning me-2"></i>
                                Movie DateTime <span class="text-danger">*</span>
                            </label>

                            <input type="datetime-local"
                                   class="form-control"
                                   id="DateTime"
                                   asp-for="Movie.DateTime"
                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                   required>
                        </div>

                        <!-- Categories -->
                        <div class="mb-3">
                            <label class="form-label">Category</label>

                            <select asp-for="Movie.CategoryId" class="form-select">
                                <option value="">-- Select Category --</option>
                                @foreach (var item in Model.Categories)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>

                            <span asp-validation-for="Movie.CategoryId" class="text-danger"></span>
                        </div>

                        <!-- Actors -->
                        <div class="mb-3">
                            <label class="form-label">Actor</label>

                            <select asp-for="Movie.ActorId" class="form-select">
                                <option value="">-- Select Actor --</option>
                                @foreach (var item in Model.Actors)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>

                            <span asp-validation-for="Movie.ActorId" class="text-danger"></span>
                        </div>

                        <!-- Cinemas -->
                        <div class="mb-3">
                            <label class="form-label">Cinema</label>

                            <select asp-for="Movie.CinemaId" class="form-select">
                                <option value="">-- Select Cinema --</option>
                                @foreach (var item in Model.Cinemas)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>

                            <span asp-validation-for="Movie.CinemaId" class="text-danger"></span>
                        </div>

                        <!-- Status -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold d-block">
                                <i class="fas fa-toggle-on text-warning me-2"></i>
                                Status
                            </label>

                            <div class="d-flex align-items-center gap-3">
                                <div class="form-check form-switch fs-5 mb-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="Status"
                                           asp-for="Movie.Status">
                                </div>

                                <span id="statusText" class="badge bg-success">
                                    Active
                                </span>
                            </div>
                        </div>

                        <hr class="border-secondary">

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2">

                            <button type="reset" class="btn btn-outline-warning">
                                <i class="fas fa-redo me-1"></i>
                                Reset
                            </button>

                            <button type="submit" class="btn btn-warning fw-semibold">
                                <i class="fas fa-save me-1"></i>
                                Create Movie
                            </button>

                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts{

    <partial name="_ValidationScriptsPartial"/>
}

@* Status *@
<script>
    const statusSwitch = document.getElementById('Status');
    const statusText = document.getElementById('statusText');

    function updateStatus() {
        statusText.textContent = statusSwitch.checked ? 'Active' : 'Inactive';

        statusText.className = statusSwitch.checked
            ? 'badge bg-success'
            : 'badge bg-danger';
    }

    statusSwitch.addEventListener('change', updateStatus);

    updateStatus();
</script>

@* Image *@
<script>
    function previewImage(event) {
        const file = event.target.files[0];
        const preview = document.getElementById('preview');

        if (file) {
            preview.src = URL.createObjectURL(file);
            preview.style.display = 'block';
        } else {
            preview.src = '#';
            preview.style.display = 'none';
        }
    }
</script>

@* SubImages *@
<script>
    function previewMultipleImages(event) {

        const files = event.target.files;
        const container = document.getElementById('previewContainer');

        container.innerHTML = '';

        for (let i = 0; i < files.length; i++) {

            const img = document.createElement('img');

            img.src = URL.createObjectURL(files[i]);

            img.style.width = '200px';
            img.style.height = '140px';
            img.style.objectFit = 'cover';
            img.style.borderRadius = '10px';
            img.style.border = '1px solid #dee2e6';
            img.style.padding = '5px';

            container.appendChild(img);
        }
    }
</script>

@* Select Count *@
<script>
    document.querySelectorAll('.multi-select-dropdown').forEach(dropdown => {

        const group = dropdown.querySelector('[data-group]');

        if (!group) return;

        const groupName = group.dataset.group;
        const textElement = document.getElementById(groupName + 'Text');
        const countElement = document.getElementById(groupName + 'Count');

        function updateSelection() {
            const selected = dropdown.querySelectorAll(
                'input[data-group]:checked'
            );

            countElement.textContent = selected.length;

            if (selected.length === 0) {
                const labels = {
                    categories: 'Select Categories',
                    actors: 'Select Actors',
                    cinemas: 'Select Cinemas'
                };

                textElement.textContent = labels[groupName];
            } else {
                textElement.textContent = Array.from(selected)
                    .map(input => input.dataset.text)
                    .join(', ');
            }
        }

        dropdown.querySelectorAll('input[data-group]').forEach(input => {
            input.addEventListener('change', updateSelection);
        });

        updateSelection();
    });

    document.querySelector('button[type="reset"]').addEventListener('click', function () {
        setTimeout(function () {
            document.querySelectorAll('.multi-select-dropdown').forEach(dropdown => {
                const group = dropdown.querySelector('[data-group]');
                if (!group) return;

                const groupName = group.dataset.group;

                document.getElementById(groupName + 'Count').textContent = '0';

                const labels = {
                    categories: 'Select Categories',
                    actors: 'Select Actors',
                    cinemas: 'Select Cinemas'
                };

                document.getElementById(groupName + 'Text').textContent = labels[groupName];
            });
        }, 0);
    });
</script>
