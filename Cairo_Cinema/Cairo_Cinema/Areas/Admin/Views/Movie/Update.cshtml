@using Cairo_Cinema.ViewModel
@model MovieVM

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="fas fa-plus-circle text-warning me-2"></i>
                Create Movie
            </h2>
            <p class="text-secondary mb-0">
                Add a new movie to your movie website.
            </p>
        </div>

        <a href="/Admin/Movie/Index" class="btn btn-outline-warning">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Movies
        </a>
    </div>

    <!-- Create Movie Form -->
    <div class="row">
        <div class="col-12 col-lg-12 col-xl-12">

            <div class="card bg-dark text-light border-secondary shadow-sm">

                <div class="card-header border-secondary py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-layer-group text-warning me-2"></i>
                        Movie Information
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Update" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Movie.Id" />
                        <!-- Name -->
                        <div class="mb-4">
                            <label asp-for="Movie.Name" class="form-label fw-semibold">
                                <i class="fas fa-film text-warning me-2"></i>
                                Movie Name <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="Name"
                                   asp-for="Movie.Name"
                                   placeholder="Enter movie name"
                                   required>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label for="Description" class="form-label fw-semibold">
                                <i class="fas fa-align-left text-warning me-2"></i>
                                Description
                            </label>

                            <textarea class="form-control"
                                      id="Description"
                                      asp-for="Movie.Description"
                                      rows="4"
                                      placeholder="Write a short description..."></textarea>
                        </div>

                        <!-- Main Image -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-image text-warning me-2"></i>
                                Movie MainImage
                            </label>

                            <input type="file"
                                   class="form-control"
                                   id="Image"
                                   name="ImageFile"
                                   accept="image/*"
                                   onchange="previewImage(event)">

                            <div class="mt-3">
                                <img id="preview"
                                     src="~/Images/Movie/@Model.Movie.MainImage"
                                     alt="Movie MainImage"
                                     style="width: 200px;
                                height: 140px;
                                object-fit: cover;
                                border-radius: 10px;
                                border: 1px solid #dee2e6;
                                padding: 5px;">
                            </div>
                        </div>

                        <!-- Movie SubImages -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                <i class="fas fa-images text-warning me-2"></i>
                                Movie SubImages
                            </label>

                            <input type="file"
                                   class="form-control"
                                   id="SubImages"
                                   name="MovieSubImages"
                                   accept="image/*"
                                   multiple
                                   onchange="previewMultipleImages(event)">

                            <!-- Images Preview -->
                            <div id="previewContainer" class="mt-3 d-flex flex-wrap gap-3">

                                @foreach (var image in Model.MovieSubImages)
                                {
                                    <div style="position: relative; width: 200px; height: 140px;">

                                        <img src="~/Images/MovieSubImage/@image.Image"
                                             alt="Movie SubImage"
                                             style="width: 100%;
                                        height: 100%;
                                        object-fit: cover;
                                        border-radius: 10px;
                                        border: 1px solid #dee2e6;
                                        padding: 5px;">

                                        <a href="/Admin/Movie/DeleteSubImage?movieId=@image.MovieId&Image=@image.Image"
                                           class="btn btn-danger rounded-1"
                                           style="position: absolute;
                                            top: 5px;
                                            right: 5px;
                                            width: 30px;
                                            height: 30px;
                                            padding: 0;
                                            display: flex;
                                            align-items: center;
                                            justify-content: center;
                                            z-index: 2;">
                                            X
                                        </a>

                                    </div>
                                }

                            </div>

                        </div>

                        <!-- Price -->
                        <div class="mb-4">
                            <label asp-for="Movie.Price"
                                   class="form-label fw-semibold">
                                <i class="fas fa-money-bill-wave text-warning me-2"></i>
                                Movie Price <span class="text-danger">*</span>
                            </label>

                            <input type="number"
                                   class="form-control"
                                   id="Price"
                                   asp-for="Movie.Price"
                                   required>
                        </div>

                        <!-- Rate -->
                        <div class="mb-4">
                            <label asp-for="Movie.Rate" class="form-label fw-semibold">
                                <i class="fas fa-star text-warning me-2"></i>
                                Movie Rate <span class="text-danger">*</span>
                            </label>

                            <input type="number"
                                   class="form-control"
                                   id="Rate"
                                   asp-for="Movie.Rate"
                                   required>
                        </div>

                        <!-- DateTime -->
                        <div class="mb-4">
                            <label asp-for="Movie.DateTime" class="form-label fw-semibold">
                                <i class="fas fa-calendar-alt text-warning me-2"></i>
                                Movie DateTime <span class="text-danger">*</span>
                            </label>

                            <input type="datetime-local"
                                   class="form-control"
                                   id="DateTime"
                                   asp-for="Movie.DateTime"
                                   
                                   required>
                        </div>

                        <!-- Categories -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-tags text-warning me-2"></i>
                                Categories
                            </label>

                            <div class="dropdown multi-select-dropdown">
                                <button class="form-select text-start d-flex justify-content-between align-items-center"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside"
                                        aria-expanded="false">
                                    <span id="categoriesText">Select Categories</span>
                                    <span class="badge bg-warning text-dark" id="categoriesCount">0</span>
                                </button>

                                <div class="dropdown-menu w-100 p-2 multi-select-menu">
                                    @foreach (var item in Model.Categories)
                                    {
                                        @if (item.Id == Model.Movie.CategoryId)
                                            {
                                            <label class="multi-select-option">
                                                <input type="checkbox"
                                                       name="Movie.CategoryId"
                                                       value="@item.Id"
                                                       class="form-check-input"
                                                       data-group="categories"
                                                       checked
                                                       data-text="@item.Name">
                                                       
                                                <span>@item.Name</span>
                                            </label>
                                            }
                                            else
                                            {
                                            <label class="multi-select-option">
                                                <input type="checkbox"
                                                       name="Movie.CategoryId"
                                                       value="@item.Id"
                                                       class="form-check-input"
                                                       data-group="categories"
                                                       data-text="@item.Name">

                                                <span>@item.Name</span>
                                            </label>
                                            }
                                        }
                                </div>
                            </div>
                        </div>

                        <!-- Actors -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-users text-warning me-2"></i>
                                Actors
                            </label>

                            <div class="dropdown multi-select-dropdown">
                                <button class="form-select text-start d-flex justify-content-between align-items-center"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside"
                                        aria-expanded="false">
                                    <span id="actorsText">Select Actors</span>
                                    <span class="badge bg-warning text-dark" id="actorsCount">0</span>
                                </button>

                                <div class="dropdown-menu w-100 p-2 multi-select-menu">
                                    @foreach (var item in Model.Actors)
                                    {
                                            if(item.Id == Model.Movie.ActorId)
                                            {
                                            <label class="multi-select-option">
                                                <input type="checkbox"
                                                       name="Movie.ActorId"
                                                       value="@item.Id"
                                                       class="form-check-input"
                                                       data-group="actors"
                                                       checked
                                                       data-text="@item.Name">
                                                <span>@item.Name</span>
                                            </label>
                                            }
                                            else
                                            {
                                            {
                                                <label class="multi-select-option">
                                                    <input type="checkbox"
                                                           name="Movie.ActorId"
                                                           value="@item.Id"
                                                           class="form-check-input"
                                                           data-group="actors"
                                                           data-text="@item.Name">
                                                    <span>@item.Name</span>
                                                </label>
                                            }
                                            }
                                        }
                                </div>
                            </div>
                        </div>

                        <!-- Cinemas -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-building text-warning me-2"></i>
                                Cinemas
                            </label>

                            <div class="dropdown multi-select-dropdown">
                                <button class="form-select text-start d-flex justify-content-between align-items-center"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside"
                                        aria-expanded="false">
                                    <span id="cinemasText">Select Cinemas</span>
                                    <span class="badge bg-warning text-dark" id="cinemasCount">0</span>
                                </button>

                                <div class="dropdown-menu w-100 p-2 multi-select-menu">
                                    @foreach (var item in Model.Cinemas)
                                    {
                                            if(item.Id == Model.Movie.CinemaId)
                                            {
                                            <label class="multi-select-option">
                                                <input type="checkbox"
                                                       name="Movie.CinemaId"
                                                       value="@item.Id"
                                                       class="form-check-input"
                                                       data-group="cinemas"
                                                       checked
                                                       data-text="@item.Name">

                                                <span>@item.Name</span>
                                            </label>
                                            }
                                            else
                                            {
                                            <label class="multi-select-option">
                                                <input type="checkbox"
                                                       name="Movie.CinemaId"
                                                       value="@item.Id"
                                                       class="form-check-input"
                                                       data-group="cinemas"
                                                       data-text="@item.Name">

                                                <span>@item.Name</span>
                                            </label>
                                            }
                                        }
                                </div>
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold d-block">
                                <i class="fas fa-toggle-on text-warning me-2"></i>
                                Status
                            </label>

                            <div class="d-flex align-items-center gap-3">
                                <div class="form-check form-switch fs-5 mb-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="Status"
                                           asp-for="Movie.Status">
                                </div>

                                <span id="statusText" class="badge bg-success">
                                    Active
                                </span>
                            </div>
                        </div>

                        <hr class="border-secondary">

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2">

                            <button type="submit" class="btn btn-warning fw-semibold">
                                <i class="fas fa-save me-1"></i>
                                Update Movie
                            </button>

                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>

</div>

@* Status *@
<script>
    const statusSwitch = document.getElementById('Status');
    const statusText = document.getElementById('statusText');

    function updateStatus() {
        statusText.textContent = statusSwitch.checked ? 'Active' : 'Inactive';

        statusText.className = statusSwitch.checked
            ? 'badge bg-success'
            : 'badge bg-danger';
    }

    statusSwitch.addEventListener('change', updateStatus);

    updateStatus();
</script>

@* MainIamge SubIamges *@
<script>
    // Main Image Preview
    function previewImage(event) {

        const file = event.target.files[0];
        const preview = document.getElementById('preview');

        if (file) {
            preview.src = URL.createObjectURL(file);
        }
    }

    // SubImages Preview
    function previewMultipleImages(event) {

        const files = event.target.files;
        const container = document.getElementById('previewContainer');

        container.innerHTML = '';

        for (let i = 0; i < files.length; i++) {

            const img = document.createElement('img');

            img.src = URL.createObjectURL(files[i]);

            img.style.width = '200px';
            img.style.height = '140px';
            img.style.objectFit = 'cover';
            img.style.borderRadius = '10px';
            img.style.border = '1px solid #dee2e6';
            img.style.padding = '5px';

            container.appendChild(img);
        }
    }
</script>

@* Select Count *@
<script>
    document.querySelectorAll('.multi-select-dropdown').forEach(dropdown => {

        const group = dropdown.querySelector('[data-group]');

        if (!group) return;

        const groupName = group.dataset.group;
        const textElement = document.getElementById(groupName + 'Text');
        const countElement = document.getElementById(groupName + 'Count');

        function updateSelection() {
            const selected = dropdown.querySelectorAll(
                'input[data-group]:checked'
            );

            countElement.textContent = selected.length;

            if (selected.length === 0) {
                const labels = {
                    categories: 'Select Categories',
                    actors: 'Select Actors',
                    cinemas: 'Select Cinemas'
                };

                textElement.textContent = labels[groupName];
            } else {
                textElement.textContent = Array.from(selected)
                    .map(input => input.dataset.text)
                    .join(', ');
            }
        }

        dropdown.querySelectorAll('input[data-group]').forEach(input => {
            input.addEventListener('change', updateSelection);
        });

        updateSelection();
    });

    document.querySelector('button[type="reset"]').addEventListener('click', function () {
        setTimeout(function () {
            document.querySelectorAll('.multi-select-dropdown').forEach(dropdown => {
                const group = dropdown.querySelector('[data-group]');
                if (!group) return;

                const groupName = group.dataset.group;

                document.getElementById(groupName + 'Count').textContent = '0';

                const labels = {
                    categories: 'Select Categories',
                    actors: 'Select Actors',
                    cinemas: 'Select Cinemas'
                };

                document.getElementById(groupName + 'Text').textContent = labels[groupName];
            });
        }, 0);
    });
</script>
