@using Cairo_Cinema.Models
@model IEnumerable<Category>

<style>
    .categories-page {
        color: #e9ecef;
    }

    .categories-card {
        background: #1b1f24;
        border: 1px solid #343a40;
        border-radius: 16px;
        overflow: hidden;
    }

    .categories-header {
        background: linear-gradient(135deg, #212529, #343a40);
        padding: 22px 25px;
        border-bottom: 1px solid #454b52;
    }

    .categories-title {
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .categories-subtitle {
        color: #adb5bd;
        font-size: .9rem;
        margin: 0;
    }

    .categories-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 35px;
        height: 35px;
        padding: 0 10px;
        border-radius: 10px;
        background: rgba(255, 193, 7, .14);
        color: #ffc107;
        font-weight: 700;
    }

    .btn-add-category {
        background: #ffc107;
        color: #212529;
        border: none;
        border-radius: 9px;
        padding: 10px 16px;
        font-weight: 700;
        transition: .2s ease;
        text-decoration: none;
    }

        .btn-add-category:hover {
            background: #ffca2c;
            color: #212529;
            transform: translateY(-2px);
        }

    .categories-table {
        margin-bottom: 0;
        color: #e9ecef;
        border-color: #343a40;
    }

        .categories-table thead th {
            background: #252a30;
            color: #ffc107;
            font-size: .85rem;
            font-weight: 700;
            padding: 16px 12px;
            white-space: nowrap;
            border-color: #343a40;
        }

        .categories-table tbody td {
            background: #1b1f24;
            padding: 16px 12px;
            vertical-align: middle;
            border-color: #343a40;
        }

        .categories-table tbody tr {
            transition: background .2s ease;
        }

            .categories-table tbody tr:hover td {
                background: #252a30;
            }

    .category-id {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
        height: 32px;
        padding: 0 8px;
        border-radius: 8px;
        background: #343a40;
        color: #ffc107;
        font-weight: 700;
    }

    .category-name {
        color: #f8f9fa;
        font-weight: 600;
    }

    .category-name-icon {
        color: #ffc107;
        margin-right: 8px;
    }

    .category-description {
        color: #adb5bd;
        font-size: .9rem;
        line-height: 1.7;
        min-width: 200px;
        max-width: 420px;
    }

    .category-status {
        display: inline-block;
        min-width: 90px;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: .78rem;
        font-weight: 700;
    }

    .category-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 9px;
        margin: 0 3px;
        transition: .2s ease;
    }

        .category-action:hover {
            transform: translateY(-2px);
        }

    .categories-footer {
        background: #212529;
        border-top: 1px solid #343a40;
        color: #adb5bd;
        padding: 15px 22px;
        font-size: .85rem;
    }

    @@media (max-width: 576px) {
        .categories-header {
            padding: 18px 15px;
        }

        .categories-title {
            font-size: 1.1rem;
        }

        .btn-add-category {
            padding: 9px 11px;
            font-size: .85rem;
        }
    }
</style>

<div class="container-fluid py-4 categories-page">

    <div class="categories-card shadow-lg">

        <!-- Header -->
        <div class="categories-header d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center"
                     style="width: 52px; height: 52px; font-size: 1.4rem;">
                    <i class="fas fa-layer-group"></i>
                </div>

                <div>
                    <h4 class="categories-title">
                        Categories Management
                    </h4>
                    <p class="categories-subtitle">
                        Manage and organize your movie genres
                    </p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="categories-count" title="Total categories">
                    @Model.Count()
                </div>

                <a href="/Admin/Category/Create" class="btn-add-category">
                    <i class="fas fa-plus me-2"></i>
                    Add Category
                </a>
            </div>

        </div>

        <!-- Table -->
        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-bordered text-center align-middle categories-table">

                    <thead>
                        <tr>
                            <th style="width: 100px;">ID</th>
                            <th style="min-width: 200px;">Category Name</th>
                            <th style="min-width: 250px;">Description</th>
                            <th style="width: 140px;">Status</th>
                            <th style="width: 140px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="category-id">
                                        #@item.Id
                                    </span>
                                </td>

                                <td class="text-start">
                                    <span class="category-name">
                                        <i class="fas fa-tag category-name-icon"></i>
                                        @item.Name
                                    </span>
                                </td>

                                <td class="text-start">
                                    <div class="category-description">
                                        @item.Description
                                    </div>
                                </td>

                                <td>
                                    @if (item.Status == true)
                                    {
                                        <span class="badge bg-success category-status">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger category-status">
                                            <i class="fas fa-times-circle me-1"></i>
                                            InActive
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a asp-controller="Category"
                                       asp-action="Update"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-warning category-action"
                                       title="Edit Category"
                                       aria-label="Edit Category">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <a asp-controller="Category"
                                       asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger category-action"
                                       title="Delete Category"
                                       aria-label="Delete Category"
                                       onclick="confirmDelete(event, this)">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>

        <!-- Footer -->
        <div class="categories-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
                <i class="fas fa-film text-warning me-2"></i>
                Cairo Cinema
            </span>

            <span>
                Total Categories:
                <strong class="text-warning">@Model.Count()</strong>
            </span>
        </div>

    </div>
</div>

@* SweetAlert(Delete) *@
<script>
    function confirmDelete(event, element) {
        event.preventDefault();

        const deleteUrl = element.href;

        const swalWithBootstrapButtons = Swal.mixin({
            customClass: {
                confirmButton: "btn btn-success",
                cancelButton: "btn btn-danger"
            },
            buttonsStyling: false
        });

        swalWithBootstrapButtons.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "No, cancel!",
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                swalWithBootstrapButtons.fire({
                    title: "Deleted!",
                    text: "Your category has been deleted.",
                    icon: "success",
                    showConfirmButton: false,
                    timer: 1500
                }).then(() => {
                    window.location.href = deleteUrl;
                });
            }
            else if (result.dismiss === Swal.DismissReason.cancel) {
                swalWithBootstrapButtons.fire({
                    title: "Cancelled",
                    text: "Your category is safe.",
                    icon: "error"
                });
            }
        });
    }
</script>